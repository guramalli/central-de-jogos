generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// "role" é validado na aplicação como texto simples (veja backend/src/middleware/auth.js),
// em vez de um enum do Prisma — mantém compatibilidade caso o banco troque de novo no futuro.
// Valores usados: "PLAYER" | "MODERATOR" | "ADMIN"
// Sinais de possível uso de ferramentas externas (colar resposta, padrão
// "bom demais pra ser real") — nunca bloqueia ninguém automaticamente, só
// registra pra um admin revisar depois e decidir (banir, ignorar, etc.).
model SuspiciousActivity {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  gameKey   String
  roomId    String
  reason    String   // "paste" | "too_perfect"
  detail    String?
  createdAt DateTime @default(now())
}

model User {
  id               String   @id @default(cuid())
  nickname         String   @unique
  email            String   @unique
  password         String?  // opcional — contas criadas via login com Google não têm senha
  // Conta de visitante: criada na hora, sem cadastro, só pra experimentar o
  // jogo. Não concorre a ranking nenhum e é limpa periodicamente.
  isGuest          Boolean  @default(false)
  role             String   @default("PLAYER")
  avatarUrl        String?  // foto pequena (base64), opcional
  banned           Boolean  @default(false)
  // Conta que joga normalmente, mas NÃO aparece em ranking nenhum. Serve
  // pra contas de teste do próprio time (que jogam o tempo todo validando
  // features) não distorcerem a disputa nem a premiação.
  ocultoNoRanking  Boolean  @default(false)
  // Ocultação POR JOGO. O campo acima é o interruptor geral (some de todos os
  // rankings); este permite sumir só de alguns, guardando as gameKeys — por
  // exemplo ["stop"] esconde do ranking do Stop e mantém no do Quiz.
  // Os dois convivem: a pessoa fica oculta se o geral estiver ligado OU se o
  // jogo em questão estiver nesta lista. Manter os dois evita mexer em quem
  // já está oculto hoje.
  ocultoNosRankings String[] @default([])
  // Patente fixada manualmente (guarda a "key" da patente). Serve pra contas
  // institucionais — como a do próprio site — ostentarem uma patente sem
  // precisar de pontuação. É só exibição: não altera pontos, não entra no
  // ranking e NÃO tira a patente exclusiva de quem a conquistou jogando.
  patenteStopFixa  String?
  patenteQuizFixa  String?
  playtimeMinutes  Int      @default(0)
  // Última plataforma usada pra jogar: "mobile" ou "desktop". Serve pra
  // entender o público e decidir onde investir em melhorias de interface.
  ultimaPlataforma String?
  ultimoAcesso     DateTime?

  // ===== Conta premium =====
  // Tudo aqui é ESTÉTICO e de conveniência de propósito: o ranking tem
  // premiação em dinheiro, então dar vantagem de jogo a quem paga tiraria
  // a legitimidade da disputa e afastaria quem não paga.
  premiumAte       DateTime?  // null ou data passada = conta comum
  premiumVitalicio Boolean   @default(false) // cortesia (fundadores, parceiros)
  molduraAvatar    String?   // id da moldura escolhida
  corNickname      String?   // cor personalizada do nick (hex)
  tituloPerfil     String?   // frase curta abaixo do nick
  saudacaoEntrada  String?   // mensagem ao entrar numa sala
  saudacaoSaida    String?   // mensagem ao sair
  missoes          MissaoProgresso[]

  // ===== Sequência de dias jogados =====
  streakAtual      Int      @default(0)
  streakRecorde    Int      @default(0)
  streakUltimoDia  String?  // "2026-08-11" — evita contar duas vezes no mesmo dia
  tituloExibido    String? // título de perfil que a pessoa escolheu ostentar (validado no PATCH)
  // Quando ligado, a medalha do título exibido aparece no lugar da foto no
  // hover do nick. Fica no banco (e não no navegador) porque quem vê a troca
  // são as OUTRAS pessoas, ao passar o mouse neste jogador.
  // Só vale se tituloExibido não for nulo — a checagem é feita no servidor.
  medalhaNoLugarDaFoto Boolean @default(false)
  celebration      String?  // frase de comemoração personalizada (até 20 caracteres), usada no Quiz
  city             String?
  state            String?
  birthDate        DateTime?
  termsAcceptedAt  DateTime?
  suspiciousActivities SuspiciousActivity[]
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  sentPrivateMessages     PrivateMessage[] @relation("SentMessages")
  receivedPrivateMessages PrivateMessage[] @relation("ReceivedMessages")
  quizRoomStats           QuizRoomStat[]
  stopStats               StopStat[]
  quizQuestionReports     QuizQuestionReport[]
  clanId           String?
  clan             Clan?    @relation("ClanMembers", fields: [clanId], references: [id])
  ownedClan        Clan?    @relation("ClanOwner")
  clanInvites      ClanInvite[]
  createdAt        DateTime @default(now())

  monthlyScores    MonthlyScore[]
  lifetimeScores   LifetimeScore[]
  blockScores      BlockScore[]
  wordSuggestions  WordEntry[]
  quizSuggestions  QuizQuestion[]
  feedbacks        Feedback[]
  friendshipsA     Friendship[] @relation("UserA")
  friendshipsB     Friendship[] @relation("UserB")
  chatMessages     ChatMessage[]
  // Quem entrou pelo Google recebeu um nickname gerado do nome da conta, sem
  // escolher. Este campo permite UMA troca — depois disso o nick fica fixo,
  // como o de quem se cadastrou normalmente.
  //
  // Troca livre e ilimitada seria ruim aqui: o nick aparece em ranking,
  // títulos vitalícios e histórico de campeões. Trocar toda hora quebraria o
  // reconhecimento entre jogadores e o rastro do que cada um conquistou.
  nicknameTrocado   Boolean  @default(false)
  campeonatos  CampeaoMensal[]
}

model Clan {
  id        String   @id @default(cuid())
  name      String   @unique
  tag       String
  ownerId   String   @unique
  owner     User     @relation("ClanOwner", fields: [ownerId], references: [id])
  createdAt DateTime @default(now())
  members   User[]   @relation("ClanMembers")
  invites   ClanInvite[]
}

// Convite pendente de um clã para um jogador. O dono do clã cria o convite;
// o jogador convidado aceita ou recusa pela própria tela dele.
model ClanInvite {
  id        String   @id @default(cuid())
  clanId    String
  clan      Clan     @relation(fields: [clanId], references: [id])
  invitedId String
  invited   User     @relation(fields: [invitedId], references: [id])
  status    String   @default("pending") // pending | accepted | declined
  createdAt DateTime @default(now())

  @@unique([clanId, invitedId])
}

model MonthlyScore {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  gameKey  String
  monthKey String
  points   Int    @default(0)

  @@unique([userId, gameKey, monthKey])
  // O @@unique acima começa por userId, e índice composto só serve quando a
  // consulta usa a PRIMEIRA coluna. Sete consultas filtram por gameKey +
  // monthKey sem userId — ranking, posição no perfil (dispara a cada hover
  // num nick) e a posição dos jogadores dentro da sala, que roda a cada
  // rodada. Todas varriam a tabela inteira.
  //
  // `points` no fim porque essas consultas ordenam ou comparam por ele
  // (orderBy desc no ranking, `gte` na posição): com a coluna no índice, o
  // banco resolve sem ir buscar as linhas.
  @@index([gameKey, monthKey, points])
}

model LifetimeScore {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  gameKey String
  points  Int    @default(0)

  @@unique([userId, gameKey])
}

// Pontuação do bloco atual de 10 rodadas (a "Pts Sala"), persistida para não se
// perder se o jogador sair e voltar, ou se o servidor reiniciar.
model BlockScore {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  gameKey String
  roomId  String
  points  Int    @default(0)

  @@unique([userId, gameKey, roomId])
}

model Theme {
  id    String      @id @default(cuid())
  key   String      @unique
  name  String
  words WordEntry[]
}

model WordEntry {
  id            String   @id @default(cuid())
  themeId       String
  theme         Theme    @relation(fields: [themeId], references: [id])
  letter        String
  word          String
  status        String   @default("approved") // approved | pending | rejected
  suggestedById String?
  suggestedBy   User?    @relation(fields: [suggestedById], references: [id])
  createdAt     DateTime @default(now())

  @@unique([themeId, letter, word])
}

// Aproveitamento de cada jogador em cada sala do Quiz — quantas perguntas
// tentou responder e quantas acertou. Alimenta o "% de acerto" mostrado no
// hover de perfil (ex.: alguém muito bom em esportes tem 90% na sala de
// esportes).
model QuizRoomStat {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id])
  roomId   String
  attempts Int    @default(0)
  correct  Int    @default(0)

  @@unique([userId, roomId])
}

model Friendship {
  id       String @id @default(cuid())
  userAId  String
  userA    User   @relation("UserA", fields: [userAId], references: [id])
  userBId  String
  userB    User   @relation("UserB", fields: [userBId], references: [id])
  status   String @default("pending") // pending | accepted

  @@unique([userAId, userBId])
}

// Mensagem privada entre dois amigos — só pode existir entre quem já tem
// amizade aceita (checado no momento de entrar na conversa, não aqui).
model PrivateMessage {
  id         String   @id @default(cuid())
  senderId   String
  sender     User     @relation("SentMessages", fields: [senderId], references: [id])
  receiverId String
  receiver   User     @relation("ReceivedMessages", fields: [receiverId], references: [id])
  message    String
  read       Boolean  @default(false)
  createdAt  DateTime @default(now())
}

model ChatMessage {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  message   String
  createdAt DateTime @default(now())
}

// Recorde de respostas corretas seguidas (sequência) em cada sala do Quiz.
// Uma linha por sala — guarda só o maior streak já feito ali.
model QuizStreakRecord {
  roomId   String @id
  userId   String
  nickname String
  count    Int
}

// Estatísticas simples da plataforma como um todo (ex.: recorde de jogadores
// simultâneos). Guardado como pares chave/valor pra não precisar criar uma
// tabela nova cada vez que surgir uma estatística nova.
model PlatformStat {
  key   String @id
  value Int
}

// Feedback enviado pelos jogadores (ideias, bugs, sugestões) — visível no
// Painel Admin, e opcionalmente também enviado por e-mail se configurado.
model Feedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  type      String   // ideia | bug | outro
  message   String
  createdAt DateTime @default(now())
}

// Banco de perguntas do Quiz, organizado por tema (ex.: "esportes", "cinema").
// Sem fila de aprovação por enquanto — populado direto pelo seed/admin.
// Denúncia de pergunta feita por jogador dentro da sala — quando alguém
// percebe erro na pergunta, resposta errada, ou pergunta fora do tema.
// Um admin revisa depois no painel e corrige ou remove a pergunta.
model QuizQuestionReport {
  id         String   @id @default(cuid())
  questionId String
  question   QuizQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  reason     String   // "tema_errado" | "resposta_errada" | "escrita" | "outro"
  comment    String?
  resolved   Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@unique([questionId, userId])
}

model QuizQuestion {
  id            String   @id @default(cuid())
  themeKey      String
  question      String
  answer        String
  status        String   @default("approved") // approved | pending | rejected
  difficulty    String   @default("medio") // facil | medio | dificil
  validated     Boolean  @default(false) // true depois de passar pelo validador por IA
  validationNote String? // observação da IA quando marca como suspeita/incorreta
  suggestedById String?
  suggestedBy   User?    @relation(fields: [suggestedById], references: [id])
  reports       QuizQuestionReport[]
  createdAt     DateTime @default(now())

  // Índice da consulta mais quente do jogo.
  //
  // O montarFilaDePerguntas filtra sempre por status e, conforme a sala, por
  // themeKey e difficulty. Sem índice o Postgres varria as ~15 mil linhas a
  // cada remontagem de fila — e isso acontece por sala, toda vez que as
  // perguntas daquela sala esgotam.
  //
  // A ordem dos campos importa: `status` vem primeiro porque é o único filtro
  // sempre presente; os outros dois entram conforme a sala.
  @@index([status, themeKey, difficulty])
}

// Pares de perguntas que o admin já revisou na tela de "parecidas" e marcou
// como legítimos (ex.: "Copa de 1974" e "Copa de 1990"). Sem isso, todo lote
// novo de perguntas recalculava a lista e trazia de volta o que já tinha sido
// aprovado. A chave é o par de ids em ordem alfabética, pra não depender de
// qual veio primeiro.
// Grupos de perguntas com a MESMA RESPOSTA que o admin já revisou e aprovou.
//
// Mesmo motivo do QuizParDiferente logo abaixo: sem isto, todo lote novo
// recalcula a lista e traz de volta o que já foi analisado. Resposta repetida
// é normal — várias perguntas diferentes podem levar ao mesmo lugar. Depois
// que o admin olha e decide que está tudo certo, o grupo precisa sumir da
// lista, senão o painel vira ruído e deixa de ser usado.
//
// A chave é tema + resposta normalizada (sem acento, caixa ou pontuação).
// Se uma pergunta NOVA com a mesma resposta aparecer depois, o grupo volta a
// aparecer: a contagem muda, e vale uma nova olhada.
// Campeão de cada mês, por jogo. CONGELADO no fechamento.
//
// POR QUE GRAVAR EM VEZ DE CALCULAR NA HORA:
// O ranking de um mês é uma consulta ordenada sobre monthlyScore. Se no
// futuro uma conta for banida, ocultada do ranking ou apagada, essa consulta
// passa a devolver OUTRO campeão para um mês que já foi pago. Alguém perderia
// um troféu conquistado, sem entender por quê.
//
// Gravando uma vez, o troféu fica imune a qualquer mexida posterior nos
// dados. Serve também de registro do que foi pago.
//
// PREENCHIDO PELO SCRIPT `npm run fechar-mes -- 2026-08`, nunca por rotina
// automática: não existe fechamento agendado no projeto, e criar um seria um
// ponto único de falha justamente com dinheiro envolvido.
model CampeaoMensal {
  id        String   @id @default(cuid())
  monthKey  String   // "2026-08"
  gameKey   String   // "stop" | "quiz"
  userId    String
  user      User     @relation(fields: [userId], references: [id])
  nickname  String   // guardado junto: se o nick mudar, o troféu registra o da época
  points    Int
  createdAt DateTime @default(now())

  // Um campeão por mês/jogo. Impede gravar dois por engano.
  @@unique([monthKey, gameKey])
  @@index([userId])
}

model QuizRespostaAprovada {
  id         String   @id @default(cuid())
  themeKey   String
  chave      String   // resposta normalizada
  quantidade Int      // quantas perguntas tinha quando foi aprovado
  createdAt  DateTime @default(now())

  @@unique([themeKey, chave])
}

model QuizParDiferente {
  id        String   @id @default(cuid())
  idA       String   // id da primeira pergunta (sempre o menor alfabeticamente)
  idB       String   // id da segunda
  createdAt DateTime @default(now())

  @@unique([idA, idB])
}

// ===== Missões diárias e semanais =====
// A definição de cada missão fica no código (src/game/missoes.js), não no
// banco: assim dá pra ajustar objetivos e recompensas sem migration. Aqui
// guardamos só o PROGRESSO de cada pessoa.
model MissaoProgresso {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  missaoKey  String   // qual missão (ex: "acertar_10_quiz")
  periodo    String   // "2026-08-11" (diária) ou "2026-W33" (semanal)
  progresso  Int      @default(0)
  meta       Int      // guardado junto: se a missão mudar, o histórico não quebra
  concluida  Boolean  @default(false)
  resgatada  Boolean  @default(false)
  concluidaEm DateTime?
  createdAt  DateTime @default(now())

  @@unique([userId, missaoKey, periodo])
  @@index([userId, periodo])
}

// Contadores de STOP pedidos por jogador, agrupados por nível de sala
// (padrao | intermediario | avancada). Alimentam os TÍTULOS do perfil.
// "rapidos" conta os STOPs pedidos em até N segundos do início da rodada
// (janela configurada em titulosConfig) — só faz sentido na avançada, onde
// o tempo mínimo de 5s deixa 1 segundo de margem: coisa de elite.
model StopStat {
  id      String @id @default(cuid())
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  grupo   String // padrao | intermediario | avancada
  stops   Int    @default(0)
  rapidos Int    @default(0)

  @@unique([userId, grupo])
}
