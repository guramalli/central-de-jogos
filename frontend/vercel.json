{
  "redirects": [
    { "source": "/lenda-do-campinho", "destination": "/lenda-do-campinho/", "permanent": false },
    { "source": "/lenda", "destination": "/lenda/", "permanent": false },
    { "source": "/lenda/wiki", "destination": "/lenda/wiki/", "permanent": false },
    { "source": "/lenda/wiki/en", "destination": "/lenda/wiki/en/", "permanent": false },
    { "source": "/jocelino", "destination": "/jocelino/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/lenda-do-campinho/", "destination": "/lenda-do-campinho/index.html" },
    { "source": "/lenda/", "destination": "/lenda/index.html" },
    { "source": "/lenda/wiki/", "destination": "/lenda/wiki/index.html" },
    { "source": "/lenda/wiki/en/", "destination": "/lenda/wiki/en/index.html" },
    { "source": "/jocelino/", "destination": "/jocelino/index.html" },
    { "source": "/v2", "destination": "/v2/index.html" },
    { "source": "/v2/(.*)", "destination": "/v2/index.html" },
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/(.*\\.(?:png|svg|jpg|jpeg|webp|gif|ico|mp3|ogg|wav|woff|woff2|mp4|zip))",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, stale-while-revalidate=86400" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/lenda-do-campinho/(.*\\.(?:js|css))",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/lenda-do-campinho/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }]
    },
    {
      "source": "/jocelino/(.*\\.wasm)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/jocelino/(.*\\.(?:pck|js|html))",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
